{
  "note": "Todas las hojas de jefes usan el mismo formato: cuadros de 256x256, 8 columnas x 5 filas. Filas 0-2 = animaciones propias del jefe, fila 3 = daño (3 cuadros), fila 4 = muerte (8 cuadros). Los jefes nuevos (dibujados por código y exportados con exportar_jefes.js) usan la fila 4 para una animación extra.",
  "frameWidth": 256,
  "frameHeight": 256,
  "columns": 8,
  "rows": 5,
  "pivot": {
    "x": 128,
    "y": 140,
    "note": "centro del cuerpo del jefe"
  },
  "common": {
    "hurt": {
      "row": 3,
      "frames": 3,
      "fps": 14,
      "loop": false
    },
    "death": {
      "row": 4,
      "frames": 8,
      "fps": 10,
      "loop": false,
      "note": "versión vieja; el juego usa jefes_muerte.png / jefes_muerte.json"
    }
  },
  "deathStyles": {
    "monstro": "grita y se hincha hasta reventar en trozos de carne, dientes y sangre; un ojo sale rodando",
    "duque_moscas": "las moscas de dentro lo empujan, se hincha, revienta y el enjambre se dispersa",
    "isaac_oscuro": "se agrieta con luz como un espejo, estalla en fragmentos y sólo quedan sus ojos rojos que se apagan",
    "rey_koopa": "se marea (estrellas y ojos en espiral), se esconde en el caparazón, se agrieta y se parte en dos",
    "dragon_fin": "aletea sin control mientras le salen rayos de luz y se deshace en polvo morado",
    "dr_huevon": "la nave echa humo y chispas, se ladea, explota y el doctor sale volando chamuscado",
    "rey_fantasma": "se pone azul asustado y parpadea, revienta en humo, los ojos huyen y la corona cae al suelo",
    "cerebro_madre": "el frasco se raja y gotea, estalla el vidrio, se derrama el líquido y el cerebro se marchita",
    "gurdy": "las pústulas se inflan, revienta en carne y pus y las moscas escapan",
    "peep": "llora a mares, revienta en un charco amarillo y los ojos salen rodando",
    "viuda": "se da vuelta panza arriba, se hace polvo y huyen las arañitas",
    "pie_mama": "encoge los dedos de dolor y se retira hacia arriba dejando polvo",
    "satanas": "se agrieta con luz del infierno y arde hasta ser ceniza",
    "rey_slime": "tiembla, se derrite en un charco y la corona cae rebotando",
    "rey_boo": "se tapa la cara avergonzado, se esfuma en humo y cae la corona",
    "nave_nodriza": "echa humo y chispas, explota y el marciano escapa volando",
    "ridley": "aletea desesperado y se deshace en brasas",
    "wither": "se raja con luz blanca, estalla en bloques y deja la estrella del Nether",
    "ganon": "se convierte en piedra y la estatua se desmorona",
    "sans": "se hace polvo de abajo hacia arriba",
    "baldi": "falla como el problema imposible: tiembla, se separa en colores y se deshace en estática",
    "dr_fetus": "el frasco se raja y revienta en vidrios; el traje se cae entre humo y el fetito sale volando",
    "diablo": "¡A KNOCKOUT!: tiembla, se pone negro y se derrite en un charco de tinta que salpica"
  },
